# Lead source label (stored in n8n / Sheets)
NEXT_PUBLIC_LEAD_SOURCE=victorialeads.ca

# n8n webhooks (Oracle VM + Cloudflare → n8n.cbhrcom.com)
# Defaults are used if unset — override only when your paths differ.
NEXT_PUBLIC_N8N_DEMO_WEBHOOK_URL=https://n8n.cbhrcom.com/webhook/victoria-leads-demo
NEXT_PUBLIC_N8N_BRIEF_WEBHOOK_URL=https://n8n.cbhrcom.com/webhook/victoria-leads-campaign-brief
